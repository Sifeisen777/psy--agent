# 复制本文件为 application-local.yml，填入自己的配置。
# application-local.yml 已被 .gitignore 忽略，不会提交到仓库。
#
# Windows 下可用：
#   copy application-local.yml.example application-local.yml

psy:
  ai:
    # DeepSeek 控制台申请：https://platform.deepseek.com
    api-key: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    # 也可以换成通义/智谱/vLLM 的 OpenAI 兼容地址
    base-url: https://api.deepseek.com
    model: deepseek-chat

