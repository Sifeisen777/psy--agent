# 本地配置模板。复制为 application-local.yml 后填入真实值。
# application-local.yml 已被 .gitignore 忽略，不会提交到仓库。
#
# Windows:
#   copy application-local.yml.example application-local.yml

psy:
  ai:
    # 模型密钥；留空则启用 Mock 实现，服务仍可启动
    # DeepSeek 控制台：https://platform.deepseek.com
    api-key: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    # 兼容 OpenAI 协议的服务地址，也可替换为通义 / 智谱 / 本地 vLLM
    base-url: https://api.deepseek.com
    model: deepseek-chat

  # MCP 端点独立令牌，外部模型客户端通过 X-MCP-Token 携带；生产环境务必替换
  mcp:
    access-token: dev-mcp-token

  # 危机告警邮件通道：默认关闭，只写结构化日志 + 落库；开启前需配置可达的 SMTP
  alert:
    mail:
      enabled: false
      to:
      from: psy-agent@localhost
      host: localhost
      port: 25

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/psy_agent?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: your-mysql-password

  data:
    redis:
      host: localhost
      port: 6379
      password: your-redis-password
      # 建议使用独立库，避免与同一实例上的其他应用共用 db0
      database: 1
      timeout: 3s
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 2
